# Data path
DATA_ROOT="/path/to/data"

# Grafana Configuration
GRAFANA_ADMIN_USER=<admin-username>
GRAFANA_ADMIN_PASSWORD=<admin-password>

# Samba Configuration
SAMBA_NAME=<samba-sharename>

# General Configuration
TZ=Etc/UTC

# Scaleway remote backup
SCW_ACCESS_KEY=<scaleway-access-key>
SCW_SECRET_KEY=<scaleway-secret-key>
RESTIC_REPOSITORY=s3:s3.nl-ams.scw.cloud/<bucket-name>
RESTIC_PASSWORD=<strong-repository-password>